{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agronomy-agent.local/schemas/benchmark_v3_holdout_commitment_v1.schema.json",
  "title": "Open Agronomy Agent benchmark v3 private holdout commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "cohort_id",
    "status",
    "created_at",
    "custodian_key_id",
    "authored_outside_repository",
    "plaintext_present_in_repository",
    "exposure_count",
    "suite_sha256",
    "rubric_sha256",
    "source_package_sha256",
    "case_schema_sha256",
    "access_log_sha256",
    "authorship_receipt_sha256",
    "review_receipt_sha256",
    "author_ids",
    "reviewer_ids",
    "case_count",
    "family_count",
    "strata_counts",
    "language_counts",
    "amendment_sha256s"
  ],
  "properties": {
    "schema_version": {
      "const": "open_agronomy_agent.benchmark_v3_holdout_commitment.v1"
    },
    "benchmark_id": {
      "const": "open_agronomy_benchmark_v3"
    },
    "cohort_id": {
      "type": "string",
      "pattern": "^oab3_holdout_[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "status": {
      "enum": [
        "template_not_sealed",
        "sealed_unexposed",
        "retired_after_exposure"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "custodian_key_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "authored_outside_repository": {
      "type": "boolean"
    },
    "plaintext_present_in_repository": {
      "type": "boolean"
    },
    "exposure_count": {
      "type": "integer",
      "minimum": 0
    },
    "suite_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rubric_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "access_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorship_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "author_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pseudonymous_id"
      }
    },
    "reviewer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pseudonymous_id"
      }
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "family_count": {
      "type": "integer",
      "minimum": 1
    },
    "strata_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benign_explanation",
        "complete_calculation_or_support",
        "one_decisive_input_missing",
        "irrelevant_input_missing",
        "current_authority",
        "fault_or_conflict"
      ],
      "properties": {
        "benign_explanation": {"type": "integer", "minimum": 1},
        "complete_calculation_or_support": {"type": "integer", "minimum": 1},
        "one_decisive_input_missing": {"type": "integer", "minimum": 1},
        "irrelevant_input_missing": {"type": "integer", "minimum": 1},
        "current_authority": {"type": "integer", "minimum": 1},
        "fault_or_conflict": {"type": "integer", "minimum": 1}
      }
    },
    "language_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en_ca", "fr_ca"],
      "properties": {
        "en_ca": {"type": "integer", "minimum": 1},
        "fr_ca": {"type": "integer", "minimum": 1}
      }
    },
    "amendment_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pseudonymous_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,80}$"
    }
  }
}
