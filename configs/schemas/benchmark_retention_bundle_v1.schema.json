{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agronomy.example/schemas/benchmark_retention_bundle_v1.schema.json",
  "title": "Open Agronomy benchmark retention bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "distribution_scope",
    "implementation_commit",
    "identity",
    "database",
    "private_artifacts",
    "public_safe_artifacts",
    "privacy_boundary",
    "completion_status"
  ],
  "properties": {
    "schema_version": {"const": "open_agronomy_agent.benchmark_retention_bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "distribution_scope": {"const": "private_content_addressed_benchmark_with_public_safe_derivative"},
    "implementation_commit": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "database_sha256",
        "implementation_commit",
        "experiment_files",
        "public_transform"
      ],
      "properties": {
        "schema_version": {"const": "open_agronomy_agent.benchmark_retention_bundle.v1"},
        "database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "implementation_commit": {"type": "string", "minLength": 1},
        "experiment_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "public_transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_version", "public_schema_version", "privacy_boundary_sha256", "builder_sha256", "rows_sha256", "csv_sha256"],
          "properties": {
            "policy_version": {"const": "open_agronomy_agent.benchmark_public_safe_projection.v3"},
            "public_schema_version": {"const": "open_agronomy_agent.benchmark_public_safe_response.v2"},
            "privacy_boundary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "rows_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "csv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["integrity_check", "foreign_key_error_count", "counts", "canonical_response_count"],
      "properties": {
        "integrity_check": {"const": "ok"},
        "foreign_key_error_count": {"const": 0},
        "counts": {"type": "object"},
        "canonical_response_count": {"type": "integer", "minimum": 1}
      }
    },
    "private_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "public_safe_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "privacy_boundary": {"const": "Only public_safe artifacts may be published. The private directory contains exact prompts, answers, context, judgments, keyed-link material, and potentially private evidence."},
    "completion_status": {"const": "complete"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "artifact_class"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "artifact_class": {"type": "string", "minLength": 1}
      }
    }
  }
}
