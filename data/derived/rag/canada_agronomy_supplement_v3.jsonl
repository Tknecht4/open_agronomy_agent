{"doc_id": "mb_2026_crop_disease_scouting_semantic_0003", "title": "Manitoba 2026 potato late-blight prevention and farm biosecurity", "text": "For Manitoba potato late-blight prevention, combine local weather monitoring with frequent scouting, giving extra attention to low, sheltered, or persistently wet parts of a field. Start with healthy seed, remove volunteer potatoes and susceptible weed hosts, manage cull piles so they cannot supply inoculum, and use rotation and irrigation timing to avoid unnecessarily extending leaf wetness. Clean soil and plant debris from storage areas, footwear, tools, and equipment before disinfection, and keep a log of field and storage visits to reduce farm-to-farm spread. These practices reduce introduction and spread; they do not prove the pathogen is present. Product selection, timing, rate, and rainfastness require the current PMRA label and current provincial disease information.", "source": "https://www.gov.mb.ca/agriculture/crops/guides-and-publications/", "source_id": "mb_2026_crop_disease_scouting", "download_url": "https://www.gov.mb.ca/agriculture/crops/guides-and-publications/pubs/guide-crop-protection-diseases-2026.pdf", "publisher": "Manitoba Agriculture", "license": "redistributable", "license_snapshot": {"status": "redistributable", "identifier": "OpenMB Information and Data Use Licence", "evidence_url": "https://www.gov.mb.ca/legal/copyright.html", "reviewed_on": "2026-07-24", "attribution": "Contains information from the Manitoba government, licensed under the OpenMB Information and Data Use Licence (Manitoba.ca/OpenMB).", "permits_modification": true, "permits_commercial": true, "permits_redistribution": true}, "sft_status": "unknown", "source_type": "applied_guidance", "document_type": "current_provincial_crop_scouting_guide", "format": "pdf", "region": ["Manitoba"], "jurisdiction": ["Manitoba"], "language": ["en-CA"], "currency": {"status": "current_2026_edition", "review_interval_days": 90, "volatile": true}, "re