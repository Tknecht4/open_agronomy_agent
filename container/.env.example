# Shared host/model settings
AGRONOMY_AGENT_MODEL_ID=mlx-community/gemma-4-e2b-it-4bit
AGRONOMY_AGENT_MODEL_CONFIG=configs/model_gemma4_e2b_interface_v2.yaml
AGRONOMY_AGENT_MODEL_REVISION=238767527555cb75a05732a84dff5d6ba0dd6809
AGRONOMY_AGENT_MODEL_PORT=8081
AGRONOMY_AGENT_MODEL_MAX_TOKENS=640
AGRONOMY_AGENT_MODEL_PREFILL_STEP_SIZE=2048
# Stable release default. Enable only after validating cache hits for the
# selected MLX/model combination.
AGRONOMY_AGENT_MODEL_PROMPT_CACHE_SIZE=0
AGRONOMY_AGENT_APP_PORT=8080
AGRONOMY_AGENT_CONTAINER_CPUS=4
AGRONOMY_AGENT_CONTAINER_MEMORY=4g
# Set to offline before leaving connectivity. Live weather, label, alert, and
# price calls will be blocked and declared in each answer trace.
AGRONOMY_AGENT_NETWORK_MODE=online

# Fixed image-contract values. Both runtimes read these from
# container/runtime-defaults.env; do not change them independently.
AGRONOMY_AGENT_CONTAINER_PORT=8080
AGRONOMY_AGENT_CONTAINER_STATE_MOUNT=/state
AGRONOMY_AGENT_SPATIAL_PACK_ROOT=/state/spatial-pack

# Optional overrides
# AGRONOMY_AGENT_RUNTIME_PROFILE=conference-rehearsal
# AGRONOMY_AGENT_STATE_DIR=/absolute/internal-volume/path/to/open-agronomy-state
# AGRONOMY_AGENT_MODEL_STATE_DIR=/absolute/internal-volume/path/to/model-host-state
# AGRONOMY_AGENT_MODEL_BIND=127.0.0.1
# AGRONOMY_AGENT_MODEL_SCREEN_NAME=open-agronomy-model-host
# AGRONOMY_AGENT_IMAGE=open-agronomy-agent:edge
# AGRONOMY_AGENT_IMAGE_REPOSITORY=open-agronomy-agent
# AGRONOMY_AGENT_RELEASE_DIR=/absolute/path/to/release-output

# Apple Container sealed field-LAN mode. Keep these unset for normal loopback
# use. The TLS directory must contain tls.crt and a mode-0600 tls.key.
# AGRONOMY_AGENT_FIELD_LAN_BIND_ADDRESS=192.168.50.10
# AGRONOMY_AGENT_FIELD_LAN_ADVERTISE_HOST=field-runtime.example.local
# AGRONOMY_AGENT_FIELD_LAN_TLS_DIR=/absolute/path/to/field-lan-tls
# AGRONOMY_AGENT_FIELD_LAN_PORT=8443
